---
export const prerender = true;

import { getCollection } from "astro:content";
import BaseHead from "../../../components/BaseHead.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import FormattedDate from "../../../components/FormattedDate.astro";
import { SITE_TITLE } from "../../../consts";
import { getAllTags, slugifyTag, sortByDateDesc } from "../../../utils/posts";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const tags = getAllTags(posts);

  return tags.map(({ tag, slug }) => {
    const taggedPosts = sortByDateDesc(
      posts.filter((post) =>
        (post.data.tags ?? []).some((t) => slugifyTag(t) === slug)
      )
    );
    return {
      params: { tag: slug },
      props: { tag, taggedPosts },
    };
  });
}

const { tag, taggedPosts } = Astro.props;
const description = `Articles on ${tag} by Michał Gacek - practical engineering, architecture, and AI notes from Tiptopdesign.`;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${tag} - ${SITE_TITLE}`} description={description} />
  </head>
  <body>
    <Header />
    <main class="tag-page">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/blog/">Blog</a>
        <span aria-hidden="true">/</span>
        <span>Topics</span>
        <span aria-hidden="true">/</span>
        <span class="crumbs__current">{tag}</span>
      </nav>

      <section class="tag-intro" aria-labelledby="tag-title">
        <p class="eyebrow">Topic</p>
        <h1 id="tag-title">{tag}</h1>
        <p class="section-lead">
          {taggedPosts.length}
          {taggedPosts.length === 1 ? " article" : " articles"} on this topic.
        </p>
      </section>

      <ul class="posts-grid">
        {
          taggedPosts.map((post) => (
            <li>
              <a class="post-card card card--proof" href={`/blog/${post.id}/`}>
                {post.data.heroImage && (
                  <img
                    width={720}
                    height={405}
                    src={post.data.heroImage}
                    alt={post.data.heroAlt ?? post.data.title}
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <div class="post-card__body">
                  <h2>{post.data.title}</h2>
                  <p>{post.data.description}</p>
                  <p class="post-date">
                    <FormattedDate date={post.data.pubDate} />
                  </p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="tag-back">
        <a href="/blog/">← Back to all articles</a>
      </p>
    </main>
    <Footer />

    <style>
      .tag-page {
        width: var(--container-page);
      }

      .crumbs {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        align-items: center;
        margin-bottom: var(--space-6);
        color: var(--color-muted);
        font-size: 0.82rem;
        font-weight: 600;
      }

      .crumbs a {
        color: var(--color-blue);
        text-decoration: none;
      }

      .crumbs a:hover {
        color: var(--color-blue-deep);
        text-decoration: underline;
      }

      .crumbs__current {
        color: var(--color-ink);
      }

      .tag-intro {
        padding-bottom: var(--space-8);
        border-bottom: 1px solid var(--color-line);
      }

      .tag-intro h1 {
        margin: 0;
      }

      .posts-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-6);
        margin: var(--space-8) 0 0;
        padding: 0;
        list-style: none;
      }

      .post-card {
        display: block;
        height: 100%;
        overflow: hidden;
        color: inherit;
        text-decoration: none;
      }

      .post-card img {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
      }

      .post-card__body {
        padding: var(--space-5, 1.25rem);
      }

      .post-card h2 {
        margin: 0;
        font-size: clamp(1.14rem, 2vw, 1.34rem);
      }

      .post-card p {
        margin: var(--space-3) 0 0;
        color: var(--color-muted);
        font-size: 0.94rem;
        line-height: var(--leading-normal);
      }

      .post-date {
        color: var(--color-muted);
        font-size: 0.82rem;
        font-weight: 700;
      }

      .post-card:hover h2 {
        color: var(--color-blue-deep);
      }

      .tag-back {
        margin-top: var(--space-12);
      }

      .tag-back a {
        color: var(--color-blue);
        font-weight: 700;
        text-decoration: none;
      }

      .tag-back a:hover {
        color: var(--color-blue-deep);
        text-decoration: underline;
      }

      @media (max-width: 860px) {
        .posts-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </body>
</html>
