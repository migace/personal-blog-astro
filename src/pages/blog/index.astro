---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const [featuredPost, ...regularPosts] = posts;
const getTopics = (tags?: string[]) => tags?.slice(0, 3) ?? ["Engineering"];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="blog-page">
      <section class="blog-intro" aria-labelledby="blog-title">
        <div class="section-header">
          <p class="eyebrow">Proof library by Michał Gacek</p>
          <h1 id="blog-title">
            Practical notes on AI workflows, architecture, quality, and full-stack delivery.
          </h1>
          <p class="section-lead">
            These posts document decisions behind real systems: TypeScript,
            backend architecture, testing strategy, developer workflows, and AI
            beyond demos.
          </p>
        </div>

        <div class="focus-grid" aria-label="Writing focus">
          <div class="card card--pad">
            <strong>AI-assisted engineering</strong>
            <span>Agents, tool workflows, local automation, and evaluation.</span>
          </div>
          <div class="card card--pad">
            <strong>Software architecture</strong>
            <span>Product modeling, backend boundaries, and delivery trade-offs.</span>
          </div>
          <div class="card card--pad">
            <strong>Quality and DX</strong>
            <span>Playwright, TypeScript, CI feedback, and maintainable tests.</span>
          </div>
        </div>
      </section>

      {
        featuredPost && (
          <section class="featured-section" aria-labelledby="featured-title">
            <a class="featured-card card card--proof" href={`/blog/${featuredPost.id}/`}>
              {featuredPost.data.heroImage && (
                <img
                  width={720}
                  height={405}
                  src={featuredPost.data.heroImage}
                  alt=""
                />
              )}
              <div class="featured-copy">
                <p class="eyebrow">Featured article</p>
                <h2 id="featured-title">{featuredPost.data.title}</h2>
                <p>{featuredPost.data.description}</p>
                <div class="post-meta">
                  <span class="post-date">
                    <FormattedDate date={featuredPost.data.pubDate} />
                  </span>
                  {getTopics(featuredPost.data.tags).map((topic) => (
                    <span class="tag">{topic}</span>
                  ))}
                </div>
              </div>
            </a>
          </section>
        )
      }

      <section aria-label="All articles">
        <ul class="posts-grid">
          {
            regularPosts.map((post) => (
              <li>
                <a class="post-card card card--proof" href={`/blog/${post.id}/`}>
                  {post.data.heroImage && (
                    <img
                      width={720}
                      height={405}
                      src={post.data.heroImage}
                      alt=""
                    />
                  )}
                  <div class="post-card__body">
                    <h3>{post.data.title}</h3>
                    <p>{post.data.description}</p>
                    <div class="post-meta">
                      <span class="post-date">
                        <FormattedDate date={post.data.pubDate} />
                      </span>
                      {getTopics(post.data.tags).map((topic) => (
                        <span class="tag">{topic}</span>
                      ))}
                    </div>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .blog-page {
    width: var(--container-page);
  }

  .blog-intro {
    padding: var(--space-6) 0 var(--space-12);
    border-bottom: 1px solid var(--color-line);
  }

  .blog-intro h1 {
    max-width: 900px;
    margin: 0;
    font-size: clamp(2.1rem, 3.4vw, 3rem);
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .focus-grid strong,
  .focus-grid span {
    display: block;
  }

  .focus-grid strong {
    color: var(--color-ink);
    font-size: 0.94rem;
    line-height: 1.35;
  }

  .focus-grid span {
    margin-top: var(--space-2);
    color: var(--color-muted);
    font-size: 0.86rem;
    line-height: var(--leading-normal);
  }

  .featured-section {
    margin: var(--space-12) 0;
  }

  .featured-card {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    gap: var(--space-8);
    align-items: center;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
  }

  .featured-card img,
  .post-card img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .featured-card img {
    border-radius: var(--radius-md) 0 0 var(--radius-md);
  }

  .featured-copy {
    min-width: 0;
    padding: var(--space-8) var(--space-8) var(--space-8) 0;
  }

  .featured-copy h2 {
    margin: 0;
    font-size: clamp(1.65rem, 2.8vw, 2.35rem);
  }

  .featured-copy p:not(.eyebrow) {
    margin: var(--space-4) 0 0;
    color: var(--color-graphite);
    font-size: 0.98rem;
    line-height: var(--leading-relaxed);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-card {
    display: block;
    height: 100%;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
  }

  .post-card__body {
    padding: var(--space-5, 1.25rem);
  }

  .post-card h3 {
    margin: 0;
    font-size: clamp(1.14rem, 2vw, 1.34rem);
  }

  .post-card p {
    display: -webkit-box;
    margin: var(--space-3) 0 0;
    overflow: hidden;
    color: var(--color-muted);
    font-size: 0.94rem;
    line-height: var(--leading-normal);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    margin-top: var(--space-4);
  }

  .post-date {
    color: var(--color-muted);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .post-card:hover h3,
  .featured-card:hover h2 {
    color: var(--color-blue-deep);
  }

  @media (max-width: 860px) {
    .focus-grid,
    .featured-card,
    .posts-grid {
      grid-template-columns: 1fr;
    }

    .featured-card {
      gap: 0;
    }

    .featured-card img {
      border-radius: var(--radius-md) var(--radius-md) 0 0;
    }

    .featured-copy {
      padding: var(--space-5, 1.25rem);
    }
  }
</style>
