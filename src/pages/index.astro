---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { SITE_AUTHOR, SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { experience, testimonials } from "../data/experience";

const companies = experience.map((item) => item.company);

const posts = await getCollection("blog");
const proofSlugs = [
  "llm-workflow-e2e-tests",
  "redis-in-practice-hono-typescript",
  "cpq-and-eav-model",
];

const isBlogPost = (
  post: CollectionEntry<"blog"> | undefined
): post is CollectionEntry<"blog"> => Boolean(post);

const proofPosts = proofSlugs
  .map((slug) => posts.find((post) => post.id === slug))
  .filter(isBlogPost);

const homeStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE_TITLE,
    description: SITE_DESCRIPTION,
    url: new URL("/", Astro.site).toString(),
    author: {
      "@type": "Person",
      name: SITE_AUTHOR,
      url: new URL("/about/", Astro.site).toString(),
      sameAs: [
        "https://www.linkedin.com/in/migace",
        "https://github.com/migace",
        "https://twitter.com/gacek_michal",
      ],
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: SITE_TITLE,
    url: new URL("/", Astro.site).toString(),
    founder: {
      "@type": "Person",
      name: SITE_AUTHOR,
    },
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${SITE_TITLE} - Full-stack AI consulting by Michał Gacek`}
      description={SITE_DESCRIPTION}
      structuredData={homeStructuredData}
    />
  </head>
  <body>
    <Header />
    <main class="home">
      <section class="home-hero" aria-labelledby="home-title">
        <div class="home-hero__copy">
          <p class="eyebrow">Michał Gacek / Tiptopdesign</p>
          <h1 id="home-title">
            Full-stack AI consulting for business problems that need real execution.
          </h1>
          <p class="home-hero__lead">
            I help founders, product leaders, and technical teams turn complex
            workflows, product ideas, and AI opportunities into maintainable
            software that can reach production.
          </p>
          <div class="home-hero__actions">
            <a class="button button--primary" href="mailto:michal.gacek@tiptopdesign.pl">
              Discuss a project problem
            </a>
            <a class="button button--secondary" href="/blog/">
              Read the proof library
            </a>
          </div>
        </div>

        <aside class="home-hero__panel card card--interactive" aria-label="Delivery model">
          <p class="panel-label">Working model</p>
          <ol class="delivery-steps">
            <li><span>01</span> Understand the business constraint</li>
            <li><span>02</span> Design the technical path</li>
            <li><span>03</span> Build the full-stack system</li>
            <li><span>04</span> Evaluate AI and quality risks</li>
            <li><span>05</span> Ship, measure, and iterate</li>
          </ol>
        </aside>
      </section>

      <section class="trust-strip" aria-label="Track record">
        <p class="trust-strip__label">Senior full-stack work delivered across teams at</p>
        <ul class="trust-strip__list">
          {companies.map((company) => <li>{company}</li>)}
        </ul>
      </section>

      <section class="home-section" aria-labelledby="fit-title">
        <div class="section-header">
          <p class="eyebrow">Problem fit</p>
          <h2 class="section-title" id="fit-title">
            Useful when the problem is not just "write more code".
          </h2>
          <p class="section-lead">
            The best fit is a situation where business context, architecture,
            implementation, and AI judgment all have to meet.
          </p>
        </div>

        <div class="fit-grid">
          <article class="card card--pad card--proof">
            <span class="fit-mark">Workflow</span>
            <h3>Internal process stuck in manual work</h3>
            <p>
              Map the real workflow, remove fragile handoffs, and build a tool
              that fits how the business actually operates.
            </p>
          </article>
          <article class="card card--pad card--proof">
            <span class="fit-mark">AI</span>
            <h3>AI idea needs feasibility and delivery</h3>
            <p>
              Turn an AI concept into a scoped workflow with evaluation,
              tool-calling boundaries, and production constraints.
            </p>
          </article>
          <article class="card card--pad card--proof">
            <span class="fit-mark">Product</span>
            <h3>Prototype needs production architecture</h3>
            <p>
              Move from a promising demo to a system with maintainable
              boundaries, tests, deployment, and operating discipline.
            </p>
          </article>
        </div>
      </section>

      <section class="home-section process-section" aria-labelledby="process-title">
        <div class="section-header">
          <p class="eyebrow">How I work</p>
          <h2 class="section-title" id="process-title">
            Senior execution across the whole path.
          </h2>
        </div>

        <div class="process-line">
          <div>
            <strong>Concept</strong>
            <span>clarify the problem and constraints</span>
          </div>
          <div>
            <strong>Architecture</strong>
            <span>choose boundaries, data flows, and trade-offs</span>
          </div>
          <div>
            <strong>Implementation</strong>
            <span>build full-stack features and integration points</span>
          </div>
          <div>
            <strong>Evaluation</strong>
            <span>test quality, AI behavior, and operational risk</span>
          </div>
          <div>
            <strong>Production</strong>
            <span>ship, observe, and iterate with the team</span>
          </div>
        </div>
      </section>

      <section id="services" class="home-section services-section" aria-labelledby="services-title">
        <div class="section-header">
          <p class="eyebrow">Ways to work together</p>
          <h2 class="section-title" id="services-title">
            Four ways to get unstuck - pick the shape that fits this quarter.
          </h2>
          <p class="section-lead">
            Each engagement is sized to do one specific thing well. Start with
            the smallest one that creates clarity; the rest follows from what
            we learn.
          </p>
        </div>

        <ul class="services-meta" aria-label="Engagement format and availability">
          <li>Audits run 1–2 weeks</li>
          <li>Builds typically 4–12 weeks</li>
          <li>Most engagements kick off within 2–3 weeks of the first call</li>
        </ul>

        <div class="service-grid">
          <article class="card card--pad card--proof service-card">
            <p class="service-card__format">2-week audit</p>
            <h3>AI workflow audit</h3>
            <p class="service-card__outcome">
              In two weeks you know whether, where, and how AI fits your process
              - and what shipping it would actually cost.
            </p>
            <p class="service-card__fit">
              <span>Best for</span> teams considering AI without a clear
              hypothesis of where it creates value, or an AI feature stuck in
              proof-of-concept.
            </p>
            <p class="service-card__list-label">You get</p>
            <ul class="signal-list service-card__list">
              <li>Process map with candidate AI insertion points</li>
              <li>Per-step feasibility, risk, and quality-evaluation strategy</li>
              <li>Cost estimate covering inference, build, and run</li>
              <li>Go / no-go recommendation with a scoped next phase</li>
            </ul>
            <div class="service-card__footer">
              <a class="service-card__related" href="/blog/llm-workflow-e2e-tests/">
                Related: LLM workflow for E2E tests
              </a>
              <a
                class="button button--primary"
                href="mailto:michal.gacek@tiptopdesign.pl?subject=AI%20workflow%20audit"
              >
                Start with an audit
              </a>
            </div>
          </article>

          <article class="card card--pad card--proof service-card">
            <p class="service-card__format">1-week review</p>
            <h3>Technical architecture review</h3>
            <p class="service-card__outcome">
              You walk away knowing where the architecture will break, what to
              fix first, and what is actually fine to leave alone.
            </p>
            <p class="service-card__fit">
              <span>Best for</span> pre-investment due diligence, post-MVP
              reality checks, or onboarding a new technical lead.
            </p>
            <p class="service-card__list-label">You get</p>
            <ul class="signal-list service-card__list">
              <li>Written architecture review of boundaries, data flows, and integration risks</li>
              <li>Prioritized risk register - what blocks scale versus what is safe to ignore</li>
              <li>90-day stabilization plan</li>
              <li>Reference architecture for the next 6–12 months</li>
            </ul>
            <div class="service-card__footer">
              <a class="service-card__related" href="/blog/cpq-and-eav-model/">
                Related: How architecture shapes what is buildable
              </a>
              <a
                class="button button--primary"
                href="mailto:michal.gacek@tiptopdesign.pl?subject=Architecture%20review"
              >
                Book a review
              </a>
            </div>
          </article>

          <article class="card card--pad card--proof service-card">
            <p class="service-card__format">4–12 week build</p>
            <h3>Prototype to production</h3>
            <p class="service-card__outcome">
              A validated demo becomes a system real users can rely on - and
              that your team can keep extending after I leave.
            </p>
            <p class="service-card__fit">
              <span>Best for</span> founders with a working AI or product demo
              and no production path, and teams that need senior full-stack
              capacity to cross the gap.
            </p>
            <p class="service-card__list-label">You get</p>
            <ul class="signal-list service-card__list">
              <li>Production architecture covering data, services, deployment, and observability</li>
              <li>Full-stack implementation in your stack, shipped to real users</li>
              <li>Test and evaluation harness, including AI behavior where relevant</li>
              <li>Handoff documentation and a maintenance runbook</li>
            </ul>
            <div class="service-card__footer">
              <a class="service-card__related" href="/blog/redis-in-practice-hono-typescript/">
                Related: Real caching architecture under production load
              </a>
              <a
                class="button button--primary"
                href="mailto:michal.gacek@tiptopdesign.pl?subject=Prototype%20to%20production"
              >
                Discuss the build
              </a>
            </div>
          </article>

          <article class="card card--pad card--proof service-card">
            <p class="service-card__format">Starts with a 2-week diagnostic</p>
            <h3>Full-stack product rescue</h3>
            <p class="service-card__outcome">
              A stuck project gets a clear path forward - and a senior pair of
              hands who can execute it alongside your team.
            </p>
            <p class="service-card__fit">
              <span>Best for</span> inherited codebases, stalled rewrites, or
              projects where the original team left or burned out.
            </p>
            <p class="service-card__list-label">You get</p>
            <ul class="signal-list service-card__list">
              <li>Diagnostic of where delivery is actually blocked - technical, process, or scope</li>
              <li>Triage plan with the next three unblockers, ranked</li>
              <li>Hands-on implementation to ship the next milestone</li>
              <li>Optional ongoing senior capacity once the project is moving again</li>
            </ul>
            <div class="service-card__footer">
              <a class="service-card__related" href="/blog/end-of-fast-coding/">
                Related: Why senior judgment matters when things get hard
              </a>
              <a
                class="button button--primary"
                href="mailto:michal.gacek@tiptopdesign.pl?subject=Product%20rescue"
              >
                Tell me what is stuck
              </a>
            </div>
          </article>
        </div>

        <aside class="services-cta card card--interactive" aria-labelledby="services-cta-title">
          <div class="services-cta__copy">
            <p class="eyebrow">Not sure which one fits?</p>
            <h3 id="services-cta-title">Describe the problem in two sentences.</h3>
            <p>
              You will get a written response within 24 hours - no pitch, just
              whether and how I can help.
            </p>
          </div>
          <div class="services-cta__actions">
            <a
              class="button button--primary"
              href="mailto:michal.gacek@tiptopdesign.pl?subject=Project%20problem"
            >
              Email me the problem
            </a>
            <a
              class="button button--secondary"
              href="https://calendly.com/michal-gacek-tiptopdesign/30min"
              target="_blank"
              rel="noopener"
            >
              Book a 30-min scoping call
            </a>
          </div>
        </aside>
      </section>

      {
        testimonials.length > 0 && (
          <section class="home-section testimonials-section" aria-labelledby="testimonials-title">
            <div class="section-header">
              <p class="eyebrow">What clients say</p>
              <h2 class="section-title" id="testimonials-title">
                Senior judgment, in their words.
              </h2>
            </div>
            <div class="testimonial-grid">
              {testimonials.map((testimonial) => (
                <figure class="card card--pad testimonial-card">
                  <blockquote>{testimonial.quote}</blockquote>
                  <figcaption>
                    <strong>{testimonial.name}</strong>
                    <span>{testimonial.role}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        )
      }

      <section class="home-section proof-section" aria-labelledby="proof-title">
        <div class="section-header">
          <p class="eyebrow">Proof through work</p>
          <h2 class="section-title" id="proof-title">
            Technical writing as evidence of judgment.
          </h2>
          <p class="section-lead">
            The blog is a proof library: architecture decisions, AI workflows,
            testing strategy, backend systems, and interactive explanations.
          </p>
        </div>

        <div class="proof-grid">
          {
            proofPosts.map((post) => (
              <a class="proof-card card card--proof" href={`/blog/${post.id}/`}>
	                {post.data.heroImage && (
	                  <img
	                    src={post.data.heroImage}
	                    alt={post.data.heroAlt ?? post.data.title}
	                    width="720"
	                    height="405"
	                    loading="lazy"
	                    decoding="async"
	                  />
	                )}
                <div class="proof-card__body">
                  <p class="proof-card__date">
                    <FormattedDate date={post.data.pubDate} />
                  </p>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <section class="home-section lab-strip card card--interactive" aria-labelledby="lab-title">
        <div>
          <p class="eyebrow">Interactive lab</p>
          <h2 class="section-title" id="lab-title">
            Concepts should be touchable when timing, state, or trade-offs matter.
          </h2>
          <p class="section-lead">
            The Redis case study includes a cache-aside playground so readers can
            feel the difference between a cache miss, a cache hit, and TTL
            invalidation.
          </p>
        </div>
        <a class="button button--secondary" href="/blog/redis-in-practice-hono-typescript/#interactive-cache-aside-playground">
          Explore the Redis playground
        </a>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr);
    gap: var(--space-12);
    align-items: center;
    min-height: calc(100vh - 12rem);
    padding: var(--space-8) 0 var(--space-4);
  }

  .home-hero h1 {
    max-width: 820px;
    margin: 0;
  }

  .home-hero__lead {
    max-width: 760px;
    margin: var(--space-6) 0 0;
    color: var(--color-graphite);
    font-size: clamp(1.08rem, 1.8vw, 1.25rem);
    line-height: var(--leading-relaxed);
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .home-hero__panel {
    padding: var(--space-6);
    background:
      linear-gradient(180deg, rgba(var(--rgb-paper), 0.95), rgba(var(--rgb-canvas), 0.86)),
      linear-gradient(90deg, rgba(var(--rgb-teal), 0.08), rgba(var(--rgb-blue), 0.05));
  }

  .panel-label,
  .fit-mark {
    display: inline-flex;
    margin: 0 0 var(--space-4);
    color: var(--color-blue-deep);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .delivery-steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .delivery-steps li {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
    color: var(--color-ink);
    font-weight: 700;
    line-height: 1.35;
  }

  .delivery-steps span {
    color: var(--color-teal);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .home-section {
    scroll-margin-top: 6rem;
  }

  .trust-strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
    align-items: center;
    padding: var(--space-6) 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .trust-strip__label {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .trust-strip__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trust-strip__list li {
    color: var(--color-graphite);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }

  .testimonial-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .testimonial-card blockquote {
    margin: 0;
    color: var(--color-ink);
    font-size: 1.05rem;
    line-height: var(--leading-relaxed);
  }

  .testimonial-card blockquote::before {
    content: "\201C";
    margin-right: 0.1rem;
    color: var(--color-teal);
    font-weight: 700;
  }

  .testimonial-card figcaption {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: auto;
  }

  .testimonial-card figcaption strong {
    color: var(--color-ink);
  }

  .testimonial-card figcaption span {
    color: var(--color-muted);
    font-size: 0.86rem;
  }

  .fit-grid,
  .service-grid,
  .proof-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .fit-grid h3,
  .service-grid h3,
  .proof-grid h3 {
    margin-bottom: var(--space-3);
    font-size: 1.1rem;
  }

  .fit-grid p,
  .service-grid p,
  .proof-grid p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.94rem;
    line-height: var(--leading-normal);
  }

  .process-section {
    padding: var(--space-12) 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .process-line {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .process-line div {
    position: relative;
    padding-top: var(--space-6);
  }

  .process-line div::before {
    content: "";
    position: absolute;
    top: 0.4rem;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-line);
  }

  .process-line div::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--color-blue);
    box-shadow: 0 0 0 5px rgba(var(--rgb-blue), 0.12);
  }

  .process-line strong,
  .process-line span {
    display: block;
  }

  .process-line span {
    margin-top: var(--space-2);
    color: var(--color-muted);
    font-size: 0.86rem;
    line-height: var(--leading-normal);
  }

  .services-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .services-section .section-header {
    margin-bottom: 0;
  }

  .services-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-8);
    margin: 0;
    padding: var(--space-3) 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    list-style: none;
    color: var(--color-muted);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .services-meta li {
    position: relative;
    padding-left: 1rem;
  }

  .services-meta li::before {
    content: "";
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 0.32rem;
    height: 0.32rem;
    border-radius: 50%;
    background: var(--color-teal);
  }

  .service-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .service-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .service-card h3 {
    margin: 0;
    font-size: 1.35rem;
    line-height: var(--leading-tight);
  }

  .service-card__format {
    display: inline-flex;
    align-self: flex-start;
    margin: 0;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    background: rgba(var(--rgb-teal), 0.12);
    color: var(--color-teal);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .service-card__outcome {
    margin: 0;
    color: var(--color-ink);
    font-size: 1rem;
    font-weight: 600;
    line-height: var(--leading-normal);
  }

  .service-card__fit {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid rgba(var(--rgb-blue), 0.28);
    background: rgba(var(--rgb-canvas), 0.7);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--color-graphite);
    font-size: 0.9rem;
    line-height: var(--leading-normal);
  }

  .service-card__fit span {
    margin-right: 0.35rem;
    color: var(--color-blue-deep);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }

  .service-card__list-label {
    margin: var(--space-2) 0 calc(-1 * var(--space-2));
    color: var(--color-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
