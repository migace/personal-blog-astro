---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Page not found - ${SITE_TITLE}`}
      description="The page you were looking for does not exist. Head back to the blog or get in touch."
    />
  </head>
  <body>
    <Header />
    <main class="notfound">
      <p class="eyebrow">Error 404</p>
      <h1>This page took a wrong turn.</h1>
      <p class="notfound__lead">
        The link is broken or the page has moved. Here is where to go next.
      </p>
      <div class="notfound__actions">
        <a class="button button--primary" href="/">Go to home</a>
        <a class="button button--secondary" href="/blog/">Read the blog</a>
        <a class="button button--secondary" href="/contact/">Contact</a>
      </div>
    </main>
    <Footer />

    <style>
      .notfound {
        max-width: 640px;
        padding: var(--space-16) 0 var(--space-24);
      }

      .notfound h1 {
        margin: 0 0 var(--space-4);
      }

      .notfound__lead {
        margin: 0;
        color: var(--color-graphite);
        font-size: 1.1rem;
        line-height: var(--leading-relaxed);
      }

      .notfound__actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3);
        margin-top: var(--space-8);
      }
    </style>
  </body>
</html>
