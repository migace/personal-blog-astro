---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PostFooter from '../components/PostFooter.astro';
import { SITE_AUTHOR, SITE_TITLE } from '../consts';
import { slugifyTag } from '../utils/posts';
import { getLocaleMeta, localizePath, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface PostLink {
	url: string;
	title: string;
}

interface RelatedPost {
	url: string;
	title: string;
	description: string;
}

type Props = CollectionEntry<'blog'>['data'] & {
	prevPost?: PostLink;
	nextPost?: PostLink;
	relatedPosts?: RelatedPost[];
	readingTime?: number;
	alternates?: Partial<Record<Lang, string>>;
	langHrefs?: Partial<Record<Lang, string>>;
	ogImage?: string;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	heroAlt,
	tags,
	lang = 'en',
	prevPost,
	nextPost,
	relatedPosts,
	readingTime,
	alternates,
	langHrefs,
	ogImage,
} = Astro.props;

const t = useTranslations(lang as Lang);
const { htmlLang } = getLocaleMeta(lang as Lang);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = heroImage ? new URL(heroImage.src, Astro.site).toString() : undefined;
const articleStructuredData = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: title,
	description,
	inLanguage: htmlLang,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	mainEntityOfPage: canonicalURL.toString(),
	author: {
		"@type": "Person",
		name: SITE_AUTHOR,
		url: new URL("/about/", Astro.site).toString(),
	},
	publisher: {
		"@type": "Organization",
		name: SITE_TITLE,
		url: new URL("/", Astro.site).toString(),
	},
	...(imageURL ? { image: [imageURL] } : {}),
	...(tags?.length ? { keywords: tags.join(", ") } : {}),
};

const breadcrumbStructuredData = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: t("nav.home"),
			item: new URL(localizePath("/", lang as Lang), Astro.site).toString(),
		},
		{
			"@type": "ListItem",
			position: 2,
			name: t("nav.blog"),
			item: new URL(localizePath("/blog/", lang as Lang), Astro.site).toString(),
		},
		{
			"@type": "ListItem",
			position: 3,
			name: title,
			item: canonicalURL.toString(),
		},
	],
};
---

<html lang={htmlLang}>
	<head>
		<BaseHead
			title={title}
			description={description}
			image={ogImage}
			imageAlt={heroAlt ?? title}
			type="article"
			publishedTime={pubDate}
			updatedTime={updatedDate ?? pubDate}
			tags={tags}
			structuredData={[articleStructuredData, breadcrumbStructuredData]}
			lang={lang as Lang}
			alternates={alternates}
		/>
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0 auto;
				padding-top: var(--space-8);
			}
			.hero-image {
				width: 100%;
				max-width: 1120px;
				margin: 0 auto;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border: 1px solid var(--color-line);
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow-lift);
			}
			.prose {
				width: var(--container-content);
				max-width: calc(100% - 2em);
				margin: auto;
				padding: var(--space-8) 0 var(--space-16);
				color: var(--color-graphite);
			}
			.title {
				margin-bottom: var(--space-8);
				padding: var(--space-8) 0 var(--space-4);
				border-bottom: 1px solid var(--color-line);
				line-height: 1;
			}
			.title h1 {
				margin: 0;
				font-size: clamp(2.1rem, 4vw, 3.35rem);
			}
			.date {
				margin-bottom: var(--space-3);
				color: var(--color-muted);
				font-size: 0.82rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}
			.reading-time::before {
				content: "·";
				margin: 0 0.5rem;
				color: var(--color-line);
			}
			.post-topics {
				display: flex;
				flex-wrap: wrap;
				gap: var(--space-2);
				margin-top: var(--space-4);
			}
			.last-updated-on {
				margin-top: var(--space-1);
				font-style: normal;
				letter-spacing: 0;
				text-transform: none;
			}
			.ai-beta-notice {
				display: flex;
				gap: var(--space-3);
				align-items: flex-start;
				margin: 0 0 var(--space-8);
				padding: var(--space-3) var(--space-4);
				border: 1px solid var(--color-line);
				border-left: 3px solid var(--color-teal);
				border-radius: var(--radius-sm);
				background: rgba(var(--rgb-teal), 0.06);
			}
			.ai-beta-notice__badge {
				flex: 0 0 auto;
				margin-top: 0.1rem;
				padding: 0.12rem 0.45rem;
				border-radius: 999px;
				background: rgba(var(--rgb-teal), 0.16);
				color: var(--color-teal-text);
				font-size: 0.66rem;
				font-weight: 700;
				letter-spacing: 0.06em;
				text-transform: uppercase;
			}
			.ai-beta-notice p {
				margin: 0;
				color: var(--color-graphite);
				font-size: 0.86rem;
				line-height: var(--leading-normal);
			}
			.ai-beta-notice a {
				color: var(--color-accent);
				font-weight: 700;
				text-decoration: none;
			}
			.ai-beta-notice a:hover {
				color: var(--color-accent-strong);
				text-decoration: underline;
			}
		</style>
		<style is:global>
			/* === Interactive code block === */
			.prose .code-card {
				--code-bg: var(--color-code);
				--code-border: rgba(148, 163, 184, 0.18);
				--code-fg: #e2e8f0;
				--code-muted: #94a3b8;
				position: relative;
				margin: 1.75em 0;
				border-radius: var(--radius-lg);
				background: linear-gradient(180deg, var(--color-code) 0%, #0a0f1c 100%);
				border: 1px solid var(--code-border);
				box-shadow: var(--shadow-code);
				overflow: hidden;
				transition: box-shadow 0.25s ease, transform 0.25s ease;
			}
			/* The code card is a committed dark surface in both themes, so its
			   teal chrome uses the fixed light logo teal, not theme tokens. */
			.prose .code-card:hover {
				box-shadow:
					0 1px 0 rgba(255, 255, 255, 0.05) inset,
					0 20px 50px rgba(45, 212, 191, 0.14);
			}
			.prose .code-card__bar {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				padding: 0.55rem 0.85rem;
				background: linear-gradient(
					180deg,
					rgba(255, 255, 255, 0.04) 0%,
					rgba(255, 255, 255, 0) 100%
				);
				border-bottom: 1px solid var(--code-border);
				font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
				font-size: 0.78rem;
				color: var(--code-muted);
			}
			.prose .code-card__dots {
				display: inline-flex;
				gap: 6px;
				margin-right: 0.35rem;
			}
			.prose .code-card__dots span {
				width: 11px;
				height: 11px;
				border-radius: 50%;
				background: #2a3346;
				box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
			}
			.prose .code-card__dots span:nth-child(1) { background: #ff5f57; }
			.prose .code-card__dots span:nth-child(2) { background: #febc2e; }
			.prose .code-card__dots span:nth-child(3) { background: #28c840; }
			.prose .code-card__lang {
				display: inline-flex;
				align-items: center;
				padding: 2px 8px;
				border-radius: 999px;
				background: rgba(45, 212, 191, 0.14);
				color: #7ee8da;
				font-weight: 600;
				letter-spacing: 0.04em;
				text-transform: uppercase;
				font-size: 0.68rem;
			}
			.prose .code-card__file {
				color: var(--code-muted);
				font-weight: 500;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.prose .code-card__spacer { flex: 1; }
			.prose .code-card__btn {
				appearance: none;
				border: 1px solid var(--code-border);
				background: rgba(255, 255, 255, 0.03);
				color: var(--code-fg);
				font-family: inherit;
				font-size: 0.72rem;
				padding: 4px 9px;
				border-radius: 7px;
				cursor: pointer;
				display: inline-flex;
				align-items: center;
				gap: 5px;
				transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
			}
			.prose .code-card__btn:hover {
				background: rgba(45, 212, 191, 0.16);
				border-color: rgba(45, 212, 191, 0.5);
				color: #ccfbf1;
			}
			.prose .code-card__btn[data-state="ok"] {
				background: rgba(34, 197, 94, 0.15);
				border-color: rgba(34, 197, 94, 0.45);
				color: #bbf7d0;
			}
			.prose .code-card__btn svg {
				width: 12px;
				height: 12px;
			}

			.prose .code-card pre {
				margin: 0 !important;
				border-radius: 0 !important;
				background: transparent !important;
				padding: 1rem 1.1rem !important;
				font-size: 0.92rem;
				overflow-x: auto;
				counter-reset: line;
			}
			.prose .code-card pre code > .line {
				display: inline-block;
				width: 100%;
				padding: 0 0.4rem;
				border-left: 2px solid transparent;
				transition: background 0.12s ease, border-color 0.12s ease;
			}
			.prose .code-card pre code > .line:hover {
				background: rgba(148, 163, 184, 0.07);
			}
			.prose .code-card[data-numbered="true"] pre code > .line::before {
				counter-increment: line;
				content: counter(line);
				display: inline-block;
				width: 1.8rem;
				margin-right: 0.9rem;
				text-align: right;
				color: rgba(148, 163, 184, 0.45);
				user-select: none;
			}
			.prose .code-card pre code > .line.is-marked {
				background: rgba(45, 212, 191, 0.13);
				border-left-color: #2dd4bf;
			}

			.prose .code-card[data-collapsible="true"][data-collapsed="true"] pre {
				max-height: 280px;
				overflow: hidden;
			}
			.prose .code-card[data-collapsible="true"][data-collapsed="true"]::after {
				content: "";
				position: absolute;
				left: 0;
				right: 0;
				bottom: 38px;
				height: 80px;
				background: linear-gradient(180deg, rgba(10, 15, 28, 0) 0%, #0a0f1c 90%);
				pointer-events: none;
			}
			.prose .code-card__expand {
				display: none;
				width: 100%;
				border: none;
				border-top: 1px solid var(--code-border);
				background: rgba(255, 255, 255, 0.02);
				color: #7ee8da;
				font-family: inherit;
				font-size: 0.78rem;
				padding: 0.55rem;
				cursor: pointer;
				letter-spacing: 0.03em;
			}
			.prose .code-card__expand:hover { background: rgba(45, 212, 191, 0.1); }
			.prose .code-card[data-collapsible="true"] .code-card__expand { display: block; }

			/* Inline `code` styling lives in styles/typography.css. */

			.prose .table-scroll {
				margin: 1.5em 0;
				overflow-x: auto;
			}

			.prose .table-scroll table {
				min-width: 480px;
				margin: 0;
			}
		</style>
	</head>

	<body>
		<Header lang={lang as Lang} langHrefs={langHrefs} />
		<main id="main">
			<article>
				<div class="hero-image">
					{
						heroImage && (
							<Image
								src={heroImage}
								alt={heroAlt ?? title}
								widths={[480, 800, 1120, 1440]}
								sizes="(max-width: 1160px) 100vw, 1120px"
								decoding="async"
								loading="eager"
								fetchpriority="high"
							/>
						)
					}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} lang={lang as Lang} />
							{readingTime && <span class="reading-time">{readingTime} {t("post.readingTime")}</span>}
							{
								updatedDate && (
									<div class="last-updated-on">
										{t("post.lastUpdated")} <FormattedDate date={updatedDate} lang={lang as Lang} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						{
							tags && tags.length > 0 && (
								<div class="post-topics">
									{tags.map((tag) => (
										<a class="tag" href={localizePath(`/blog/tags/${slugifyTag(tag)}/`, lang as Lang)}>
											{tag}
										</a>
									))}
								</div>
							)
						}
					</div>
					{
						lang === "pl" && (
							<aside class="ai-beta-notice" role="note">
								<span class="ai-beta-notice__badge">{t("beta.badge")}</span>
								<p>
									{t("beta.notice")}
									{alternates?.en && (
										<>
											{" "}
											<a href={alternates.en}>{t("beta.viewOriginal")}</a>.
										</>
									)}
								</p>
							</aside>
						)
					}
					<slot />
					<PostFooter prevPost={prevPost} nextPost={nextPost} relatedPosts={relatedPosts} lang={lang as Lang} />
				</div>
			</article>
		</main>
		<Footer lang={lang as Lang} />
		{/* i18n strings as a JSON data block (not executable JS, so it is not
		    governed by the CSP `script-src` directive - see vercel.json). The
		    bundled script below reads it by id. */}
		<script
			type="application/json"
			id="code-i18n"
			set:html={JSON.stringify({
				copy: t("code.copy"),
				copied: t("code.copied"),
				lines: t("code.lines"),
				toggleLines: t("code.toggleLines"),
				copyToClipboard: t("code.copyToClipboard"),
				collapse: t("code.collapse"),
				expand: t("code.expand"),
				expandLines: t("code.expandLines"),
			})}
		/>
		{/* is:inline keeps this out of Astro's TS processing (loose DOM access)
		    and makes it a static, CSP-hashable inline script - the locale strings
		    now live in the JSON data block above, so this body never varies. Its
		    hash is in vercel.json (regenerate with `pnpm csp:hashes`). */}
		<script is:inline>
			(() => {
				const COLLAPSE_THRESHOLD = 14;
				const dataEl = document.getElementById("code-i18n");
				let parsed = {};
				try {
					parsed = dataEl ? JSON.parse(dataEl.textContent || "{}") : {};
				} catch {
					/* fall back to the English defaults below */
				}
				const I = Object.assign(
					{
						copy: "Copy",
						copied: "Copied",
						lines: "Lines",
						toggleLines: "Toggle line numbers",
						copyToClipboard: "Copy to clipboard",
						collapse: "Collapse",
						expand: "Expand",
						expandLines: "lines",
					},
					parsed
				);

				const ICON_COPY =
					'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>';
				const ICON_OK =
					'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
				const ICON_HASH =
					'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9h16M4 15h16M10 3 8 21M16 3l-2 18"/></svg>';

				function detectFilename(code) {
					const first = code.split("\n").slice(0, 2).join("\n");
					const m = first.match(/(?:from\s+["'])([^"']+?)(?:["'])/);
					if (m) return m[1].split("/").pop();
					return "";
				}

				function wrapLines(pre) {
					const code = pre.querySelector("code");
					if (!code || code.dataset.lined === "1") return;

					const hasExistingLines = code.querySelector(":scope > .line");
					if (!hasExistingLines) {
						const html = code.innerHTML;
						const lines = html.split(/\n/);
						code.innerHTML = lines
							.map((l) => '<span class="line">' + (l.length ? l : "&nbsp;") + "</span>")
							.join("\n");
					}
					code.dataset.lined = "1";

					code.querySelectorAll(":scope > .line").forEach((line) => {
						line.addEventListener("click", () => line.classList.toggle("is-marked"));
					});
				}

				document.querySelectorAll(".prose pre").forEach((pre) => {
					if (pre.parentElement && pre.parentElement.classList.contains("code-card")) return;

					const codeEl = pre.querySelector("code");
					const raw = codeEl ? codeEl.textContent || "" : pre.textContent || "";
					const lineCount = raw.split("\n").length;

					let lang = "";
					if (codeEl) {
						const cls = (codeEl.className || "").match(/language-([\w-]+)/);
						if (cls) lang = cls[1];
					}
					if (!lang && pre.dataset.language) lang = pre.dataset.language;

					const filename = detectFilename(raw);

					const card = document.createElement("div");
					card.className = "code-card";
					card.dataset.numbered = "false";
					if (lineCount > COLLAPSE_THRESHOLD) {
						card.dataset.collapsible = "true";
						card.dataset.collapsed = "true";
					}

					const bar = document.createElement("div");
					bar.className = "code-card__bar";
					bar.innerHTML =
						'<span class="code-card__dots"><span></span><span></span><span></span></span>' +
						(lang ? '<span class="code-card__lang">' + lang + "</span>" : "") +
						(filename ? '<span class="code-card__file">' + filename + "</span>" : "") +
						'<span class="code-card__spacer"></span>';

					const numBtn = document.createElement("button");
					numBtn.type = "button";
					numBtn.className = "code-card__btn";
					numBtn.title = I.toggleLines;
					numBtn.innerHTML = ICON_HASH + "<span>" + I.lines + "</span>";
					numBtn.addEventListener("click", () => {
						const on = card.dataset.numbered === "true";
						card.dataset.numbered = on ? "false" : "true";
					});

					const copyBtn = document.createElement("button");
					copyBtn.type = "button";
					copyBtn.className = "code-card__btn";
					copyBtn.title = I.copyToClipboard;
					copyBtn.innerHTML = ICON_COPY + "<span>" + I.copy + "</span>";
					copyBtn.addEventListener("click", async () => {
						try {
							await navigator.clipboard.writeText(raw);
							copyBtn.dataset.state = "ok";
							copyBtn.innerHTML = ICON_OK + "<span>" + I.copied + "</span>";
							setTimeout(() => {
								copyBtn.dataset.state = "";
								copyBtn.innerHTML = ICON_COPY + "<span>" + I.copy + "</span>";
							}, 1600);
						} catch (e) {}
					});

					bar.appendChild(numBtn);
					bar.appendChild(copyBtn);

					pre.parentNode.insertBefore(card, pre);
					card.appendChild(bar);
					card.appendChild(pre);

					wrapLines(pre);

					if (card.dataset.collapsible === "true") {
						const expand = document.createElement("button");
						expand.type = "button";
						expand.className = "code-card__expand";
						expand.textContent = I.expand + " " + lineCount + " " + I.expandLines;
						expand.addEventListener("click", () => {
							const collapsed = card.dataset.collapsed === "true";
							card.dataset.collapsed = collapsed ? "false" : "true";
							expand.textContent = collapsed
								? I.collapse
								: I.expand + " " + lineCount + " " + I.expandLines;
						});
						card.appendChild(expand);
					}
				});

				// Wide MDX tables must scroll inside their own container instead
				// of overflowing the page on mobile.
				document.querySelectorAll(".prose table").forEach((table) => {
					if (table.parentElement && table.parentElement.classList.contains("table-scroll")) return;
					const wrap = document.createElement("div");
					wrap.className = "table-scroll";
					table.parentNode.insertBefore(wrap, table);
					wrap.appendChild(table);
				});
			})();
		</script>
	</body>
</html>
