---
// Plain reading page for an app's support or legal text (e.g. the Quadra
// privacy policy the app stores link to). The slot is rendered inside `.prose`.
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getLocaleMeta } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  eyebrow: string;
  eyebrowHref?: string;
  heading: string;
  meta?: string;
  lead: string;
}

const { lang, title, description, eyebrow, eyebrowHref, heading, meta, lead } = Astro.props;
const { htmlLang } = getLocaleMeta(lang);
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <BaseHead title={title} description={description} lang={lang} />
  </head>
  <body>
    <Header lang={lang} />
    <main id="main" class="app-doc">
      <header class="app-doc__header">
        <p class="eyebrow">{eyebrowHref ? <a href={eyebrowHref}>{eyebrow}</a> : eyebrow}</p>
        <h1>{heading}</h1>
        {meta && <p class="app-doc__meta">{meta}</p>}
        <p class="app-doc__lead">{lead}</p>
      </header>
      <div class="prose">
        <slot />
      </div>
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  .app-doc {
    width: var(--container-content);
    max-width: calc(100% - 2rem);
  }

  .app-doc__header {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-line);
  }

  .app-doc__header h1 {
    margin: 0;
  }

  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  .eyebrow a:hover {
    text-decoration: underline;
  }

  .app-doc__meta {
    margin: var(--space-3) 0 0;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .app-doc__lead {
    margin: var(--space-6) 0 0;
    color: var(--color-graphite);
    font-size: clamp(1.08rem, 1.8vw, 1.24rem);
    line-height: var(--leading-relaxed);
  }
</style>
