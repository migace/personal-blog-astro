---
// Reusable confetti burst. Drop <Confetti /> anywhere on a page and trigger it
// from any script with:  window.dispatchEvent(new CustomEvent("confetti:fire"))
//
// The canvas uses the Popover API so a burst joins the top layer *above* an open
// modal <dialog> (and its backdrop) instead of being painted behind it. It is a
// plain Astro component with a bundled script - no client island to hydrate, so
// it can never end up as an empty island.
interface Props {
  /** Window event that triggers a burst. */
  eventName?: string;
  /** Number of confetti pieces per burst. */
  count?: number;
  /** Animation length in milliseconds. */
  duration?: number;
}

const { eventName = "confetti:fire", count = 150, duration = 2600 } =
  Astro.props;
---

<canvas
  class="confetti-canvas"
  aria-hidden="true"
  popover="manual"
  data-confetti
  data-event={eventName}
  data-count={count}
  data-duration={duration}></canvas>

<script>
  type Piece = {
    x: number;
    y: number;
    r: number;
    color: string;
    vx: number;
    vy: number;
    rot: number;
    vr: number;
    rect: boolean;
  };

  type ConfettiCanvas = HTMLCanvasElement & {
    showPopover?: () => void;
    hidePopover?: () => void;
  };

  const COLORS = ["#1f4fd8", "#12a89d", "#84cc16", "#f59e0b", "#163b94"];

  function setup(canvas: ConfettiCanvas) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const eventName = canvas.dataset.event || "confetti:fire";
    const count = Number(canvas.dataset.count) || 150;
    const duration = Number(canvas.dataset.duration) || 2600;

    const supportsPopover =
      typeof canvas.showPopover === "function" &&
      typeof canvas.hidePopover === "function";

    const isOpen = () => {
      try {
        return canvas.matches(":popover-open");
      } catch {
        return false;
      }
    };

    let raf: number | null = null;

    const fire = () => {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      if (supportsPopover && !isOpen()) {
        try {
          canvas.showPopover?.();
        } catch {
          /* ignore */
        }
      }

      const w = (canvas.width = window.innerWidth);
      const h = (canvas.height = window.innerHeight);
      const pieces: Piece[] = [];
      for (let i = 0; i < count; i++) {
        pieces.push({
          x: w / 2 + (Math.random() - 0.5) * 160,
          y: h / 2.6 + (Math.random() - 0.5) * 40,
          r: 4 + Math.random() * 7,
          color: COLORS[(Math.random() * COLORS.length) | 0],
          vx: (Math.random() - 0.5) * 13,
          vy: -7 - Math.random() * 11,
          rot: Math.random() * Math.PI,
          vr: (Math.random() - 0.5) * 0.35,
          rect: Math.random() > 0.5,
        });
      }

      const start = performance.now();
      const frame = (now: number) => {
        const t = now - start;
        ctx.clearRect(0, 0, w, h);
        for (const p of pieces) {
          p.vy += 0.35;
          p.vx *= 0.99;
          p.x += p.vx;
          p.y += p.vy;
          p.rot += p.vr;
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rot);
          ctx.globalAlpha = Math.max(0, 1 - t / duration);
          ctx.fillStyle = p.color;
          if (p.rect) ctx.fillRect(-p.r / 2, -p.r / 2, p.r, p.r * 0.5);
          else {
            ctx.beginPath();
            ctx.arc(0, 0, p.r / 2, 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.restore();
        }
        if (t < duration) {
          raf = requestAnimationFrame(frame);
        } else {
          ctx.clearRect(0, 0, w, h);
          raf = null;
          if (supportsPopover && isOpen()) {
            try {
              canvas.hidePopover?.();
            } catch {
              /* ignore */
            }
          }
        }
      };

      if (raf) cancelAnimationFrame(raf);
      raf = requestAnimationFrame(frame);
    };

    window.addEventListener(eventName, fire);
  }

  document
    .querySelectorAll<ConfettiCanvas>("canvas[data-confetti]")
    .forEach(setup);
</script>

<style>
  .confetti-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    pointer-events: none;
    z-index: 1000;
  }
</style>
