---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import { SITE_AUTHOR } from "../consts";
import { LOCALES, localizePath, getLocaleMeta, defaultLang } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  publishedTime?: Date | string;
  updatedTime?: Date | string;
  tags?: string[];
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  lang?: Lang;
  // Optional per-language path overrides for hreflang alternates. When omitted,
  // alternates are derived from the current path for every locale.
  alternates?: Partial<Record<Lang, string>>;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title,
  description,
  image = "/og-default.png",
  imageAlt,
  type = "website",
  publishedTime,
  updatedTime,
  tags = [],
  structuredData,
  lang = "en",
  alternates,
} = Astro.props;

const absoluteImageURL = new URL(image, Astro.site);

const { ogLocale } = getLocaleMeta(lang);
type AltLink = { hreflang: Lang; href: string };
// When a page passes explicit alternates, trust them exclusively - a locale
// missing from the map means "no translation exists", and deriving a URL from
// the current path would emit hreflang links to 404s. The derive-from-path
// fallback only applies to pages that share the same path in every locale.
const altLinks: AltLink[] = LOCALES.flatMap((locale) => {
  const path = alternates
    ? alternates[locale]
    : localizePath(Astro.url.pathname, locale);
  return path ? [{ hreflang: locale, href: new URL(path, Astro.site).toString() }] : [];
});
const defaultAlt = altLinks.find((l) => l.hreflang === defaultLang) ?? altLinks[0];
const altOgLocales = LOCALES.filter((l) => l !== lang).map(
  (l) => getLocaleMeta(l).ogLocale
);
const schemas = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<meta name="author" content={SITE_AUTHOR} />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f8f7" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b1020" />

<!-- Resolve the color theme before first paint to avoid a flash. The stored
     user choice wins over the system preference; tokens.css keys off
     [data-theme] and falls back to prefers-color-scheme when JS is off. -->
<script is:inline>
  (() => {
    try {
      const stored = localStorage.getItem("theme");
      const theme =
        stored === "dark" || stored === "light"
          ? stored
          : window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
      document.documentElement.dataset.theme = theme;
    } catch {
      /* leave the media-query fallback in charge */
    }
  })();
</script>
<link
  rel="alternate"
  type="application/rss+xml"
  title={lang === "pl" ? "Tiptopdesign RSS (PL)" : "Tiptopdesign RSS"}
  href={localizePath("/rss.xml", lang)}
/>

<!-- Font preloads -->
<link
  rel="preload"
  href="/fonts/atkinson-regular.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<link
  rel="preload"
  href="/fonts/atkinson-bold.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Language alternates -->
{altLinks.map((l) => <link rel="alternate" hreflang={l.hreflang} href={l.href} />)}
{defaultAlt && <link rel="alternate" hreflang="x-default" href={defaultAlt.href} />}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImageURL} />
<!-- All OG images (og-default.png and public/og/*.jpg) are exported at
     1200x630; explicit dimensions let scrapers render the preview without
     fetching the file first. -->
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
<meta property="og:locale" content={ogLocale} />
{altOgLocales.map((l) => <meta property="og:locale:alternate" content={l} />)}
{
  type === "article" && (
    <>
      {publishedTime && (
        <meta property="article:published_time" content={new Date(publishedTime).toISOString()} />
      )}
      {updatedTime && (
        <meta property="article:modified_time" content={new Date(updatedTime).toISOString()} />
      )}
      <meta property="article:author" content={SITE_AUTHOR} />
      {tags.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@gacek_michal" />
<meta name="twitter:creator" content="@gacek_michal" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImageURL} />
{imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

{
  schemas.map((schema) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))
}

<!-- Vercel Web Analytics (cookieless, no consent banner needed) -->
<Analytics />

<!-- Scroll-reveal engine. A bundled (non-inline) module script, so it is emitted
     as an external /_astro/*.js file and covered by the CSP `script-src 'self'`
     - no per-build inline hash needed (unlike the theme/code scripts). Reveals
     any [data-reveal] element as it enters the viewport; stagger delays come from
     the nearest [data-reveal-stagger] ancestor. Inert under reduced motion, and
     unhides everything when IntersectionObserver is unavailable. The no-JS case
     is handled purely in CSS (see @media (scripting: none) in reveal.css). -->
<script>
  // Type assertions use `as` (not <T> generics): Astro runs this through esbuild
  // in TSX mode, where `querySelectorAll<HTMLElement>` reads as a JSX tag.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const targets = Array.from(document.querySelectorAll("[data-reveal]")) as HTMLElement[];

  if (reduce || !("IntersectionObserver" in window) || targets.length === 0) {
    // No animation: make sure nothing stays stuck at opacity 0.
    for (const el of targets) el.classList.add("is-visible");
  } else {
    // Assign stagger delays from each [data-reveal-stagger] container. First
    // writer wins, so an outer container's delays are not clobbered by an inner.
    const containers = Array.from(
      document.querySelectorAll("[data-reveal-stagger]")
    ) as HTMLElement[];
    for (const container of containers) {
      const step = Number.parseInt(container.dataset.revealStagger || "", 10) || 90;
      const items = Array.from(container.querySelectorAll("[data-reveal]")) as HTMLElement[];
      items.forEach((el, i) => {
        if (el.style.getPropertyValue("--reveal-delay")) return;
        el.style.setProperty("--reveal-delay", i * step + "ms");
      });
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.06 }
    );

    for (const el of targets) observer.observe(el);
  }
</script>
