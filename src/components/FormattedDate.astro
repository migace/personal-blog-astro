---
import { getLocaleMeta } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

interface Props {
	date: Date;
	lang?: Lang;
}

const { date, lang = "en" } = Astro.props;
const { dateLocale } = getLocaleMeta(lang);
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString(dateLocale, {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		})
	}
</time>
