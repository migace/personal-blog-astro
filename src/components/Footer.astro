---
import SocialLinks from "./SocialLinks.astro";
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const today = new Date();
---

<footer>
  <div class="footer-inner">
    <div>
      <p class="eyebrow eyebrow--deep footer-kicker">{t("footer.kicker")}</p>
      <p class="footer-copy">
        {t("footer.copy")}
      </p>
    </div>

    <div class="footer-actions">
      <a class="button button--secondary" href="mailto:michal.gacek@tiptopdesign.pl">
        michal.gacek@tiptopdesign.pl
      </a>
      <SocialLinks />
    </div>

    <p class="footer-legal">
      &copy; {today.getFullYear()} Tiptopdesign. {t("footer.rights")}
    </p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--color-line);
    background: rgba(var(--rgb-paper), 0.72);
    color: var(--color-muted);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-8);
    width: var(--container-page);
    max-width: calc(100% - 2rem);
    margin: 0 auto;
    padding: var(--space-12) 0;
  }

  .footer-kicker {
    margin-bottom: var(--space-2);
  }

  .footer-copy {
    max-width: 34rem;
    margin: 0;
    color: var(--color-graphite);
    font-size: 1rem;
    line-height: var(--leading-normal);
  }

  .footer-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-end;
  }

  .footer-legal {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  @media (max-width: 760px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      max-width: calc(100% - 1.25rem);
    }

    .footer-actions {
      align-items: flex-start;
    }
  }
</style>
