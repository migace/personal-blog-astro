---
import HeaderLink from "./HeaderLink.astro";
import SocialLinks from "./SocialLinks.astro";
import { SITE_TITLE } from "../consts";
---

<header class="site-header">
  <nav class="site-nav" aria-label="Main navigation">
    <a class="brand" href="/">
      <span>{SITE_TITLE}</span>
      <small>Michał Gacek</small>
    </a>

    <div class="internal-links">
      <a href="/#services">Services</a>
      <HeaderLink href="/blog">Blog</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
    </div>

    <div class="nav-actions">
      <SocialLinks compact />
      <a class="button button--primary nav-cta" href="mailto:michal.gacek@tiptopdesign.pl">
        Contact
      </a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid rgba(var(--rgb-line), 0.82);
    background: rgba(var(--rgb-paper), 0.9);
    backdrop-filter: blur(14px);
  }

  .site-nav {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: var(--space-4);
    align-items: center;
    width: var(--container-page);
    max-width: calc(100% - 2rem);
    min-height: 4.5rem;
    margin: 0 auto;
  }

  .brand {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    width: fit-content;
    color: var(--color-ink);
    line-height: 1.05;
    text-decoration: none;
  }

  .brand span {
    font-size: 1rem;
    font-weight: 700;
  }

  .brand small {
    margin-top: 0.16rem;
    color: var(--color-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .internal-links {
    display: flex;
    justify-content: center;
    gap: 0.25rem;
  }

  .internal-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.4rem;
    padding: 0 0.7rem;
    border-radius: var(--radius-sm);
    color: var(--color-graphite);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
  }

  .internal-links a:hover,
  .internal-links a.active {
    background: rgba(var(--rgb-blue), 0.08);
    color: var(--color-blue-deep);
  }

  .nav-actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-3);
    align-items: center;
  }

  .nav-cta {
    min-height: 2.4rem;
    padding: 0.55rem 0.85rem;
    font-size: 0.88rem;
  }

  @media (max-width: 860px) {
    .site-nav {
      grid-template-columns: 1fr auto;
      min-height: auto;
      padding: var(--space-3) 0;
    }

    .internal-links {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: flex-start;
      overflow-x: auto;
    }

    .nav-actions :global(.social-links) {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .site-nav {
      max-width: calc(100% - 1.25rem);
    }

    .brand small {
      display: none;
    }

    .nav-cta {
      min-height: 2.2rem;
    }
  }
</style>
