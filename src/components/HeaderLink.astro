---
import type { HTMLAttributes } from 'astro/types';
import { stripLangPrefix } from '../i18n/utils';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

const { pathname } = Astro.url;
const basePath = stripLangPrefix(pathname);
const localHref = typeof href === "string" ? href.split("#")[0] : href;
const baseHref = typeof localHref === "string" ? stripLangPrefix(localHref) : localHref;
const subpath = basePath.match(/[^\/]+/g);
const isActive = baseHref === basePath || baseHref === '/' + (subpath?.[0] ?? '');
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: 700;
	}
</style>
