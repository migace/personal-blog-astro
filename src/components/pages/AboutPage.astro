---
import BaseHead from "../BaseHead.astro";
import Header from "../Header.astro";
import Footer from "../Footer.astro";
import { SITE_AUTHOR, SITE_TITLE } from "../../consts";
import { experience } from "../../data/experience";
import { getLocaleMeta, localizePath } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";
import { aboutPage } from "../../i18n/content/pages";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = aboutPage[lang];
const { htmlLang } = getLocaleMeta(lang);
const items = experience[lang];

const personStructuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE_AUTHOR,
  url: new URL(localizePath("/about/", lang), Astro.site).toString(),
  image: new URL("/michal-gacek.webp", Astro.site).toString(),
  description: c.metaDescription,
  knowsAbout: [
    "AI workflows",
    "Software architecture",
    "Full-stack development",
    "TypeScript",
    "Testing strategy",
  ],
  worksFor: {
    "@type": "Organization",
    name: SITE_TITLE,
    url: new URL(localizePath("/", lang), Astro.site).toString(),
  },
  jobTitle: c.hero.eyebrow,
  sameAs: [
    "https://www.linkedin.com/in/migace",
    "https://github.com/migace",
    "https://twitter.com/gacek_michal",
  ],
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <BaseHead
      title={c.metaTitle}
      description={c.metaDescription}
      structuredData={personStructuredData}
      lang={lang}
    />
  </head>
  <body>
    <Header lang={lang} />
    <main id="main" class="about-page">
      <section class="about-hero" aria-labelledby="about-title">
        <div class="about-hero__copy" data-reveal-stagger="90">
          <p class="eyebrow" data-reveal>{c.hero.eyebrow}</p>
          <h1 id="about-title" data-reveal>{c.hero.title}</h1>
          <p class="about-lead" data-reveal>{c.hero.lead}</p>
        </div>
        <img
          class="about-portrait"
          src="/michal-gacek.webp"
          alt={c.hero.photoAlt}
          width="800"
          height="800"
          decoding="async"
          fetchpriority="high"
          data-reveal="right"
        />
      </section>

      <section class="about-section split-section" aria-labelledby="bring-title">
        <div class="section-header" data-reveal>
          <p class="eyebrow">{c.bring.eyebrow}</p>
          <h2 class="section-title" id="bring-title">{c.bring.title}</h2>
        </div>

        <div class="value-grid" data-reveal-stagger>
          {
            c.bring.cards.map((card) => (
              <article class="card card--pad" data-reveal>
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="about-section" aria-labelledby="contexts-title">
        <div class="section-header" data-reveal>
          <p class="eyebrow">{c.contexts.eyebrow}</p>
          <h2 class="section-title" id="contexts-title">{c.contexts.title}</h2>
          <p class="section-lead">{c.contexts.lead}</p>
        </div>

        <div class="experience-grid" data-reveal-stagger="80">
          {
            items.map((item) => (
              <article class="experience-card card card--pad" data-reveal>
                <p>{item.role}</p>
                <h3>{item.company}</h3>
                <span>{item.text}</span>
              </article>
            ))
          }
        </div>
      </section>

      <section class="about-section teaching-band card card--interactive" aria-labelledby="teaching-title" data-reveal="scale">
        <div>
          <p class="eyebrow">{c.teaching.eyebrow}</p>
          <h2 class="section-title" id="teaching-title">{c.teaching.title}</h2>
        </div>
        <p>{c.teaching.body}</p>
      </section>

      <section class="about-section" aria-labelledby="speaking-title">
        <div class="section-header" data-reveal>
          <p class="eyebrow">{c.speaking.eyebrow}</p>
          <h2 class="section-title" id="speaking-title">{c.speaking.title}</h2>
        </div>

        <div class="speaking-grid" data-reveal-stagger>
          {
            c.speaking.items.map((item) => (
              <a class="speaking-card card card--pad card--proof" href={item.href} target="_blank" rel="noreferrer" data-reveal>
                <h3>{item.title}</h3>
                <p>{item.desc}</p>
                <span class="speaking-card__cta">{item.cta} ↗</span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="about-section contact-section" aria-labelledby="contact-title">
        <div class="section-header" data-reveal>
          <p class="eyebrow">{c.contact.eyebrow}</p>
          <h2 class="section-title" id="contact-title">{c.contact.title}</h2>
          <p class="section-lead">{c.contact.lead}</p>
        </div>

        <div class="contact-grid" data-reveal-stagger>
          <a href="mailto:michal.gacek@tiptopdesign.pl" class="contact-card card card--proof" data-reveal>
            <div class="contact-card__icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2" />
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
              </svg>
            </div>
            <div>
              <div class="contact-card__label">{c.contact.emailLabel}</div>
              <div class="contact-card__value">michal.gacek@tiptopdesign.pl</div>
            </div>
          </a>
          <a href="https://github.com/migace" target="_blank" rel="noreferrer" class="contact-card card card--proof" data-reveal>
            <div class="contact-card__icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.2c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                <path d="M9 18c-4.51 2-5-2-7-2" />
              </svg>
            </div>
            <div>
              <div class="contact-card__label">{c.contact.githubLabel}</div>
              <div class="contact-card__value">github.com/migace</div>
            </div>
          </a>
        </div>
      </section>
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  .about-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-20, 5rem);
  }

  .about-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-12);
    align-items: center;
    padding: var(--space-8) 0 var(--space-4);
  }

  .about-hero__copy {
    max-width: 920px;
  }

  .about-hero h1 {
    margin: 0;
  }

  .about-portrait {
    width: clamp(180px, 22vw, 280px);
    height: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lift);
  }

  .about-lead {
    max-width: 840px;
    margin: var(--space-6) 0 0;
    color: var(--color-graphite);
    font-size: clamp(1.08rem, 1.8vw, 1.24rem);
    line-height: var(--leading-relaxed);
  }

  .about-section {
    scroll-margin-top: 6rem;
  }

  .value-grid,
  .experience-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .value-grid h3,
  .experience-grid h3 {
    margin-bottom: var(--space-3);
    font-size: 1.08rem;
  }

  .value-grid p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: var(--leading-normal);
  }

  .experience-grid {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .experience-card p {
    margin: 0 0 var(--space-2);
    color: var(--color-accent-strong);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .experience-card span {
    display: block;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: var(--leading-normal);
  }

  .teaching-band {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
    padding: var(--space-8);
    background:
      linear-gradient(135deg, rgba(var(--rgb-teal), 0.1), rgba(var(--rgb-paper), 0.94) 45%),
      var(--color-paper);
  }

  .teaching-band p:last-child {
    margin: 0;
    color: var(--color-graphite);
    line-height: var(--leading-relaxed);
  }

  .speaking-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .speaking-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    color: inherit;
    text-decoration: none;
  }

  .speaking-card h3 {
    margin: 0;
    font-size: 1.08rem;
  }

  .speaking-card p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: var(--leading-normal);
  }

  .speaking-card__cta {
    margin-top: auto;
    color: var(--color-accent);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .speaking-card:hover .speaking-card__cta {
    color: var(--color-accent-strong);
    text-decoration: underline;
  }

  .contact-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  @media (max-width: 860px) {
    .value-grid,
    .teaching-band,
    .speaking-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .about-page {
      gap: var(--space-12);
    }

    .about-hero {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .about-portrait {
      order: -1;
      width: 180px;
    }

    .value-grid {
      grid-template-columns: 1fr;
    }

    .teaching-band {
      padding: var(--space-5, 1.25rem);
    }
  }
</style>
