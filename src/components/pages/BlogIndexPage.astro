---
import { Image } from "astro:assets";
import BaseHead from "../BaseHead.astro";
import Footer from "../Footer.astro";
import FormattedDate from "../FormattedDate.astro";
import Header from "../Header.astro";
import { SITE_AUTHOR, SITE_TITLE } from "../../consts";
import { getAllTags, getPostUrl, type BlogEntry } from "../../utils/posts";
import { getLocaleMeta, localizePath, useTranslations } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";
import { blogPage } from "../../i18n/content/pages";

interface Props {
  lang: Lang;
  posts: BlogEntry[];
}

const { lang, posts } = Astro.props;
const c = blogPage[lang];
const t = useTranslations(lang);
const { htmlLang } = getLocaleMeta(lang);

const topics = getAllTags(posts);
const [featuredPost, ...regularPosts] = posts;
const getTopics = (tags?: string[]) => tags?.slice(0, 3) ?? [];

const blogStructuredData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: `${c.metaTitle} - ${SITE_TITLE}`,
  description: c.metaDescription,
  url: new URL(localizePath("/blog/", lang), Astro.site).toString(),
  author: {
    "@type": "Person",
    name: SITE_AUTHOR,
    url: new URL(localizePath("/about/", lang), Astro.site).toString(),
  },
  blogPost: posts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.data.title,
    url: new URL(getPostUrl(post), Astro.site).toString(),
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  })),
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <BaseHead
      title={`${c.metaTitle} - ${SITE_TITLE}`}
      description={c.metaDescription}
      structuredData={blogStructuredData}
      lang={lang}
    />
  </head>
  <body>
    <Header lang={lang} />
    <main id="main" class="blog-page">
      <section class="blog-intro" aria-labelledby="blog-title">
        <div class="section-header" data-reveal-stagger="90">
          <p class="eyebrow" data-reveal>{c.eyebrow}</p>
          <h1 id="blog-title" data-reveal>{c.title}</h1>
          <p class="section-lead" data-reveal>{c.lead}</p>
        </div>

        <div class="focus-grid" aria-label={c.browseByTopic} data-reveal-stagger>
          {
            c.focus.map((item) => (
              <div class="card card--pad" data-reveal>
                <strong>{item.title}</strong>
                <span>{item.desc}</span>
              </div>
            ))
          }
        </div>

        <nav class="topics" aria-label={c.browseByTopic} data-reveal="fade">
          <span class="topics__label">{c.browseByTopic}</span>
          <ul>
            {
              topics.map((topic) => (
                <li>
                  <a class="tag" href={localizePath(`/blog/tags/${topic.slug}/`, lang)}>
                    {topic.tag}
                    <span class="topics__count">{topic.count}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </section>

      {
        featuredPost && (
          <section class="featured-section" aria-labelledby="featured-title" data-reveal="scale">
            <a class="featured-card card card--proof" href={getPostUrl(featuredPost)}>
              {featuredPost.data.heroImage && (
	                <Image
	                  src={featuredPost.data.heroImage}
	                  alt={featuredPost.data.heroAlt ?? featuredPost.data.title}
	                  widths={[480, 720, 1080]}
	                  sizes="(max-width: 860px) 100vw, 560px"
	                  decoding="async"
	                  loading="eager"
	                  fetchpriority="high"
	                />
              )}
              <div class="featured-copy">
                <p class="eyebrow">{c.featured}</p>
                <h2 id="featured-title">{featuredPost.data.title}</h2>
                <p>{featuredPost.data.description}</p>
                <div class="post-meta">
                  <span class="post-date">
                    <FormattedDate date={featuredPost.data.pubDate} lang={lang} />
                  </span>
                  {getTopics(featuredPost.data.tags).map((topic) => (
                    <span class="tag">{topic}</span>
                  ))}
                </div>
              </div>
            </a>
          </section>
        )
      }

      <section aria-label={t("a11y.allArticles")}>
        <ul class="posts-grid" data-reveal-stagger="90">
          {
            regularPosts.map((post) => (
              <li data-reveal>
                <a class="post-card card card--proof" href={getPostUrl(post)}>
                  {post.data.heroImage && (
	                    <Image
	                      src={post.data.heroImage}
	                      alt={post.data.heroAlt ?? post.data.title}
	                      widths={[480, 720, 1080]}
	                      sizes="(max-width: 860px) 100vw, 545px"
	                      loading="lazy"
	                      decoding="async"
	                    />
                  )}
                  <div class="post-card__body">
                    <h3>{post.data.title}</h3>
                    <p>{post.data.description}</p>
                    <div class="post-meta">
                      <span class="post-date">
                        <FormattedDate date={post.data.pubDate} lang={lang} />
                      </span>
                      {getTopics(post.data.tags).map((topic) => (
                        <span class="tag">{topic}</span>
                      ))}
                    </div>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  .blog-page {
    width: var(--container-page);
  }

  .blog-intro {
    padding: var(--space-6) 0 var(--space-12);
    border-bottom: 1px solid var(--color-line);
  }

  .blog-intro h1 {
    max-width: 900px;
    margin: 0;
    font-size: clamp(2.1rem, 3.4vw, 3rem);
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .focus-grid strong,
  .focus-grid span {
    display: block;
  }

  .focus-grid strong {
    color: var(--color-ink);
    font-size: 0.94rem;
    line-height: 1.35;
  }

  .focus-grid span {
    margin-top: var(--space-2);
    color: var(--color-muted);
    font-size: 0.86rem;
    line-height: var(--leading-normal);
  }

  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    align-items: center;
    margin-top: var(--space-8);
  }

  .topics__label {
    color: var(--color-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .topics ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .topics__count {
    color: var(--color-muted);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .featured-section {
    margin: var(--space-12) 0;
  }

  .featured-card {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    gap: var(--space-8);
    align-items: center;
    padding: var(--space-4);
    overflow: hidden;
    color: inherit;
    text-decoration: none;
  }

  .featured-card img,
  .post-card img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .featured-card img {
    border-radius: var(--radius-sm);
  }

  .featured-copy {
    min-width: 0;
    padding: var(--space-6) var(--space-6) var(--space-6) 0;
  }

  .featured-copy h2 {
    margin: 0;
    font-size: clamp(1.65rem, 2.8vw, 2.35rem);
  }

  .featured-copy p:not(.eyebrow) {
    margin: var(--space-4) 0 0;
    color: var(--color-graphite);
    font-size: 0.98rem;
    line-height: var(--leading-relaxed);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-card {
    display: block;
    height: 100%;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
  }

  .post-card__body {
    padding: var(--space-5, 1.25rem);
  }

  .post-card h3 {
    margin: 0;
    font-size: clamp(1.14rem, 2vw, 1.34rem);
  }

  .post-card p {
    display: -webkit-box;
    margin: var(--space-3) 0 0;
    overflow: hidden;
    color: var(--color-muted);
    font-size: 0.94rem;
    line-height: var(--leading-normal);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    margin-top: var(--space-4);
  }

  .post-date {
    color: var(--color-muted);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .post-card:hover h3,
  .featured-card:hover h2 {
    color: var(--color-accent-strong);
  }

  @media (max-width: 860px) {
    .focus-grid,
    .featured-card,
    .posts-grid {
      grid-template-columns: 1fr;
    }

    .featured-card {
      gap: 0;
      padding: var(--space-3);
    }

    .featured-card img {
      border-radius: var(--radius-sm);
    }

    .featured-copy {
      padding: var(--space-5, 1.25rem) var(--space-2) var(--space-2);
    }
  }
</style>
