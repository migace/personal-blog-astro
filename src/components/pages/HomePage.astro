---
import { Image } from "astro:assets";
import BaseHead from "../BaseHead.astro";
import Header from "../Header.astro";
import Footer from "../Footer.astro";
import FormattedDate from "../FormattedDate.astro";
import { SITE_AUTHOR, SITE_TITLE } from "../../consts";
import { experience, testimonials } from "../../data/experience";
import { getPostSlug, getPostUrl, type BlogEntry } from "../../utils/posts";
import { getLocaleMeta, localizePath, useTranslations } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";
import { homePage } from "../../i18n/content/pages";

interface Props {
  lang: Lang;
  posts: BlogEntry[];
}

const { lang, posts } = Astro.props;
const t = useTranslations(lang);
const c = homePage[lang];
const { htmlLang } = getLocaleMeta(lang);

const companies = experience[lang].map((item) => item.company);
const cards = testimonials[lang];

const bySlug = new Map(posts.map((p) => [getPostSlug(p), p]));
const proofPosts = c.services.cards
  .map((card) => bySlug.get(card.relatedSlug))
  .filter((p): p is BlogEntry => Boolean(p))
  .slice(0, 3);
// Fall back to the three configured proof slugs if cards change.
const fallbackProof = ["llm-workflow-e2e-tests", "redis-in-practice-hono-typescript", "cpq-and-eav-model"]
  .map((slug) => bySlug.get(slug))
  .filter((p): p is BlogEntry => Boolean(p));
const proof = (proofPosts.length ? proofPosts : fallbackProof).slice(0, 3);

const mailto = (subject: string) =>
  `mailto:michal.gacek@tiptopdesign.pl?subject=${encodeURIComponent(subject)}`;
const homeStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE_TITLE,
    description: c.metaDescription,
    url: new URL(localizePath("/", lang), Astro.site).toString(),
    author: {
      "@type": "Person",
      name: SITE_AUTHOR,
      url: new URL(localizePath("/about/", lang), Astro.site).toString(),
      sameAs: [
        "https://www.linkedin.com/in/migace",
        "https://github.com/migace",
        "https://twitter.com/gacek_michal",
      ],
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: SITE_TITLE,
    url: new URL(localizePath("/", lang), Astro.site).toString(),
    founder: { "@type": "Person", name: SITE_AUTHOR },
  },
];

const contactHref = localizePath("/contact/", lang);
const blogHref = localizePath("/blog/", lang);
const redisPlaygroundHref = `${localizePath("/blog/redis-in-practice-hono-typescript/", lang)}#interactive-cache-aside-playground`;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <BaseHead
      title={c.metaTitle}
      description={c.metaDescription}
      structuredData={homeStructuredData}
      lang={lang}
    />
  </head>
  <body>
    <Header lang={lang} />
    <main id="main" class="home">
      <section class="home-hero" aria-labelledby="home-title">
        <div class="home-hero__copy">
          <p class="eyebrow">{c.hero.eyebrow}</p>
          <h1 id="home-title">{c.hero.title}</h1>
          <p class="home-hero__lead">{c.hero.lead}</p>
          <div class="home-hero__actions">
            <a class="button button--primary" href={contactHref}>{c.hero.ctaPrimary}</a>
            <a class="button button--secondary" href={blogHref}>{c.hero.ctaSecondary}</a>
          </div>
        </div>

        <aside class="home-hero__panel card card--interactive" aria-label={c.panelLabel}>
          <p class="eyebrow eyebrow--deep">{c.panelLabel}</p>
          <ol class="delivery-steps">
            {
              c.deliverySteps.map((step, i) => (
                <li>
                  <span>{String(i + 1).padStart(2, "0")}</span> {step}
                </li>
              ))
            }
          </ol>
        </aside>
      </section>

      <section class="trust-strip" aria-label={t("a11y.trackRecord")}>
        <p class="trust-strip__label">{c.trustLabel}</p>
        <ul class="trust-strip__list">
          {companies.map((company) => <li>{company}</li>)}
        </ul>
      </section>

      <section class="home-section" aria-labelledby="fit-title">
        <div class="section-header">
          <p class="eyebrow">{c.fit.eyebrow}</p>
          <h2 class="section-title" id="fit-title">{c.fit.title}</h2>
          <p class="section-lead">{c.fit.lead}</p>
        </div>

        <div class="fit-grid">
          {
            c.fit.cards.map((card) => (
              <article class="card card--pad card--proof">
                <span class="fit-mark">{card.mark}</span>
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="home-section process-section" aria-labelledby="process-title">
        <div class="section-header">
          <p class="eyebrow">{c.process.eyebrow}</p>
          <h2 class="section-title" id="process-title">{c.process.title}</h2>
        </div>

        <div class="process-line">
          {
            c.process.steps.map((step) => (
              <div>
                <strong>{step.strong}</strong>
                <span>{step.span}</span>
              </div>
            ))
          }
        </div>
      </section>

      <section id="services" class="home-section services-section" aria-labelledby="services-title">
        <div class="section-header">
          <p class="eyebrow">{c.services.eyebrow}</p>
          <h2 class="section-title" id="services-title">{c.services.title}</h2>
          <p class="section-lead">{c.services.lead}</p>
        </div>

        <ul class="services-meta" aria-label={t("a11y.engagementMeta")}>
          {c.services.meta.map((item) => <li>{item}</li>)}
        </ul>

        <div class="service-grid">
          {
            c.services.cards.map((card) => (
              <article class="card card--pad card--proof service-card">
                <p class="service-card__format">{card.format}</p>
                <h3>{card.title}</h3>
                <p class="service-card__outcome">{card.outcome}</p>
                <p class="service-card__fit">
                  <span>{c.services.fitLabel}</span> {card.fit}
                </p>
                <p class="service-card__list-label">{c.services.listLabel}</p>
                <ul class="signal-list service-card__list">
                  {card.list.map((item) => <li>{item}</li>)}
                </ul>
                <div class="service-card__footer">
                  <a class="service-card__related" href={localizePath(`/blog/${card.relatedSlug}/`, lang)}>
                    {card.related}
                  </a>
                  <a class="button button--primary" href={mailto(card.mailSubject)}>
                    {card.button}
                  </a>
                </div>
              </article>
            ))
          }
        </div>

        <aside class="services-cta card card--interactive" aria-labelledby="services-cta-title">
          <div class="services-cta__copy">
            <p class="eyebrow">{c.services.cta.eyebrow}</p>
            <h3 id="services-cta-title">{c.services.cta.title}</h3>
            <p>{c.services.cta.body}</p>
          </div>
          <div class="services-cta__actions">
            <a class="button button--primary" href={mailto(c.services.cta.mailSubject)}>
              {c.services.cta.primary}
            </a>
            <a
              class="button button--secondary"
              href="https://calendly.com/michal-gacek-tiptopdesign/30min"
              target="_blank"
              rel="noopener"
            >
              {c.services.cta.secondary}
            </a>
          </div>
        </aside>
      </section>

      {
        cards.length > 0 && (
          <section class="home-section testimonials-section" aria-labelledby="testimonials-title">
            <div class="section-header">
              <p class="eyebrow">{c.testimonials.eyebrow}</p>
              <h2 class="section-title" id="testimonials-title">{c.testimonials.title}</h2>
            </div>
            <div class="testimonial-grid">
              {cards.map((testimonial) => (
                <figure class="card card--pad testimonial-card">
                  <blockquote>{testimonial.quote}</blockquote>
                  <figcaption>
                    <strong>{testimonial.name}</strong>
                    <span>{testimonial.role}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        )
      }

      <section class="home-section proof-section" aria-labelledby="proof-title">
        <div class="section-header">
          <p class="eyebrow">{c.proof.eyebrow}</p>
          <h2 class="section-title" id="proof-title">{c.proof.title}</h2>
          <p class="section-lead">{c.proof.lead}</p>
        </div>

        <div class="proof-grid">
          {
            proof.map((post) => (
              <a class="proof-card card card--proof" href={getPostUrl(post)}>
	                {post.data.heroImage && (
	                  <Image
	                    src={post.data.heroImage}
	                    alt={post.data.heroAlt ?? post.data.title}
	                    widths={[400, 720]}
	                    sizes="(max-width: 920px) 100vw, 360px"
	                    loading="lazy"
	                    decoding="async"
	                  />
	                )}
                <div class="proof-card__body">
                  <p class="proof-card__date">
                    <FormattedDate date={post.data.pubDate} lang={lang} />
                  </p>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <section class="home-section lab-strip card card--interactive" aria-labelledby="lab-title">
        <div>
          <p class="eyebrow">{c.lab.eyebrow}</p>
          <h2 class="section-title" id="lab-title">{c.lab.title}</h2>
          <p class="section-lead">{c.lab.lead}</p>
        </div>
        <a class="button button--secondary" href={redisPlaygroundHref}>
          {c.lab.button}
        </a>
      </section>
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr);
    gap: var(--space-12);
    align-items: center;
    min-height: calc(100vh - 12rem);
    padding: var(--space-8) 0 var(--space-4);
  }

  .home-hero h1 {
    max-width: 820px;
    margin: 0;
  }

  .home-hero__lead {
    max-width: 760px;
    margin: var(--space-6) 0 0;
    color: var(--color-graphite);
    font-size: clamp(1.08rem, 1.8vw, 1.25rem);
    line-height: var(--leading-relaxed);
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .home-hero__panel {
    padding: var(--space-6);
    background:
      linear-gradient(180deg, rgba(var(--rgb-paper), 0.95), rgba(var(--rgb-canvas), 0.86)),
      linear-gradient(90deg, rgba(var(--rgb-teal), 0.08), rgba(var(--rgb-accent), 0.05));
  }

  .fit-mark {
    display: inline-flex;
    margin: 0 0 var(--space-4);
    color: var(--color-accent-strong);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .delivery-steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .delivery-steps li {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
    color: var(--color-ink);
    font-weight: 700;
    line-height: 1.35;
  }

  .delivery-steps span {
    color: var(--color-teal-text);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .home-section {
    scroll-margin-top: 6rem;
  }

  .trust-strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
    align-items: center;
    padding: var(--space-6) 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .trust-strip__label {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .trust-strip__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trust-strip__list li {
    color: var(--color-graphite);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }

  .testimonial-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .testimonial-card blockquote {
    margin: 0;
    color: var(--color-ink);
    font-size: 1.05rem;
    line-height: var(--leading-relaxed);
  }

  .testimonial-card blockquote::before {
    content: "\201C";
    margin-right: 0.1rem;
    color: var(--color-teal);
    font-weight: 700;
  }

  .testimonial-card figcaption {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: auto;
  }

  .testimonial-card figcaption strong {
    color: var(--color-ink);
  }

  .testimonial-card figcaption span {
    color: var(--color-muted);
    font-size: 0.86rem;
  }

  .fit-grid,
  .service-grid,
  .proof-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .fit-grid h3,
  .service-grid h3,
  .proof-grid h3 {
    margin-bottom: var(--space-3);
    font-size: 1.1rem;
  }

  .fit-grid p,
  .service-grid p,
  .proof-grid p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.94rem;
    line-height: var(--leading-normal);
  }

  .process-section {
    padding: var(--space-12) 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .process-line {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .process-line div {
    position: relative;
    padding-top: var(--space-6);
  }

  .process-line div::before {
    content: "";
    position: absolute;
    top: 0.4rem;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-line);
  }

  .process-line div::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 5px rgba(var(--rgb-accent), 0.12);
  }

  .process-line strong,
  .process-line span {
    display: block;
  }

  .process-line span {
    margin-top: var(--space-2);
    color: var(--color-muted);
    font-size: 0.86rem;
    line-height: var(--leading-normal);
  }

  .services-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .services-section .section-header {
    margin-bottom: 0;
  }

  .services-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-8);
    margin: 0;
    padding: var(--space-3) 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    list-style: none;
    color: var(--color-muted);
    font-size: 0.82rem;
    font-weight: 400;
    letter-spacing: 0.01em;
  }

  .services-meta li {
    position: relative;
    padding-left: 1rem;
  }

  .services-meta li::before {
    content: "";
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 0.32rem;
    height: 0.32rem;
    border-radius: 50%;
    background: var(--color-teal);
  }

  .service-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .service-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .service-card h3 {
    margin: 0;
    font-size: 1.35rem;
    line-height: var(--leading-tight);
  }

  .service-card__format {
    display: inline-flex;
    align-self: flex-start;
    margin: 0;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    background: rgba(var(--rgb-teal), 0.12);
    color: var(--color-teal-text);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .service-card__outcome {
    margin: 0;
    color: var(--color-ink);
    font-size: 1rem;
    font-weight: 700;
    line-height: var(--leading-normal);
  }

  .service-card__fit {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid rgba(var(--rgb-accent), 0.28);
    background: rgba(var(--rgb-canvas), 0.7);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--color-graphite);
    font-size: 0.9rem;
    line-height: var(--leading-normal);
  }

  .service-card__fit span {
    margin-right: 0.35rem;
    color: var(--color-accent-strong);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }

  .service-card__list-label {
    margin: var(--space-2) 0 calc(-1 * var(--space-2));
    color: var(--color-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .service-card__list {
    margin-top: var(--space-3);
  }

  .service-card__list li {
    color: var(--color-graphite);
    font-size: 0.94rem;
  }

  .service-card__footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-5, 1.25rem);
    border-top: 1px solid var(--color-line);
  }

  .service-card__related {
    color: var(--color-accent);
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
  }

  .service-card__related::before {
    content: "→ ";
    color: var(--color-teal);
  }

  .service-card__related:hover {
    color: var(--color-accent-strong);
    text-decoration: underline;
  }

  .service-card__footer .button {
    align-self: flex-start;
  }

  .services-cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-8);
    align-items: center;
    padding: var(--space-8);
    background:
      linear-gradient(135deg, rgba(var(--rgb-accent), 0.08), rgba(var(--rgb-paper), 0.94) 50%),
      var(--color-paper);
  }

  .services-cta__copy h3 {
    margin: var(--space-2) 0 var(--space-3);
    font-size: 1.4rem;
    line-height: var(--leading-tight);
  }

  .services-cta__copy p {
    margin: 0;
    max-width: 52ch;
    color: var(--color-graphite);
    font-size: 0.98rem;
    line-height: var(--leading-normal);
  }

  .services-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .proof-card {
    overflow: hidden;
    color: inherit;
    text-decoration: none;
  }

  .proof-card img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }

  .proof-card__body {
    padding: var(--space-5, 1.25rem);
  }

  .proof-card__date {
    margin: 0 0 var(--space-2);
    color: var(--color-muted);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .lab-strip {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-8);
    align-items: center;
    padding: var(--space-8);
    background:
      linear-gradient(135deg, rgba(var(--rgb-teal), 0.1), rgba(var(--rgb-paper), 0.92) 42%),
      var(--color-paper);
  }

  @media (max-width: 920px) {
    .home {
      gap: var(--space-16);
    }

    .home-hero,
    .lab-strip,
    .services-cta {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .fit-grid,
    .proof-grid,
    .process-line {
      grid-template-columns: 1fr;
    }

    .process-line div::before {
      width: 2px;
      height: 100%;
    }

    .process-line div {
      padding-top: 0;
      padding-left: var(--space-6);
    }
  }

  @media (max-width: 640px) {
    .service-grid {
      grid-template-columns: 1fr;
    }

    .lab-strip,
    .services-cta {
      padding: var(--space-5, 1.25rem);
    }

    .services-meta {
      padding: var(--space-3) var(--space-4);
      font-size: 0.82rem;
    }
  }
</style>
